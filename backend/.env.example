# Comma-separated exact frontend origins; no trailing slash or wildcard.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
REFRESH_ENABLED=true
REFRESH_INTERVAL_SECONDS=3600
# On Railway, mount a persistent volume at /data and set DATA_DIR=/data.
# Without a volume, fresh snapshots last only for this container's lifetime.
# DATA_DIR=/data
LOG_LEVEL=INFO
